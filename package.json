{
  "name": "@interop/was-sync",
  "description": "The WAS replication driver for RxDB: the changes-feed pull handler, the conditional-write push handler, the conflict-handler seam, the synced-document schema, and the session controller core.",
  "version": "0.2.7",
  "type": "module",
  "scripts": {
    "build": "pnpm run clear && tsc",
    "clear": "rimraf dist/*",
    "dev": "vite",
    "fix": "eslint --fix src test && pnpm run format",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\"",
    "lint": "eslint src test",
    "prepare": "pnpm run build",
    "rebuild": "pnpm run clear && pnpm run build",
    "typecheck": "tsc -p tsconfig.dev.json",
    "test": "pnpm run fix && pnpm run lint && pnpm run typecheck && pnpm run test:node && pnpm run test:packaging && pnpm run test:browser",
    "test:browser": "playwright test",
    "test:node": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:packaging": "pnpm run build && ! grep -rl @interop/logger dist && vitest run --config vitest.packaging.config.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rxdb": {
      "types": "./dist/rxdb.d.ts",
      "react-native": "./dist/rxdb.js",
      "import": "./dist/rxdb.js",
      "default": "./dist/rxdb.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "react-native": "./dist/testing.js",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "module": "dist/index.js",
  "browser": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@interop/social-core": "^0.8.1",
    "json-canonicalize": "^3.0.0",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@interop/ed25519-verification-key": "^8.2.0",
    "@interop/logger": "^0.2.0",
    "@interop/was-client": "^0.59.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "rxdb": "^17.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "was-teaching-server": "^0.29.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "isomorphic",
    "wallet-attached-storage",
    "replication",
    "rxdb",
    "sync",
    "offline-first"
  ],
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.0"
  },
  "author": {
    "name": "Interop Alliance",
    "url": "https://github.com/interop-alliance/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interop-alliance/was-sync.git"
  },
  "homepage": "https://github.com/interop-alliance/was-sync",
  "bugs": "https://github.com/interop-alliance/was-sync/issues",
  "peerDependencies": {
    "@interop/was-client": "^0.54.0",
    "rxdb": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "rxdb": {
      "optional": true
    }
  }
}
